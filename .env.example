
# 1. Groq API key — get from https://console.groq.com (REQUIRED)
GROQ_API_KEY=

# 2. PostgreSQL connection string (REQUIRED)
#    Format: postgresql://USER:PASSWORD@HOST:PORT/DBNAME
DATABASE_URL=

# 3. Frontend backend URL (change in production)
BACKEND_URL=

# 4. App settings
DEBUG=False

# 5. JWT secret — generate with: python -c "import secrets; print(secrets.token_hex(32))" (REQUIRED — must be changed from default)
SECRET_KEY=

# 6. CORS allowed origins — comma-separated list of frontend URLs
CORS_ORIGINS=http://localhost:3000,http://localhost:8501

# 7. Upload limit in MB
MAX_UPLOAD_SIZE_MB=5


# 8. PostgreSQL password (used by docker-compose)
POSTGRES_PASSWORD=change-me-in-production