# ─────────────────────────────────────────
# Resume Analyser AI — Environment Variables
# ─────────────────────────────────────────

# 1. Groq API key — get from https://console.groq.com
GROQ_API_KEY=

# 2. PostgreSQL connection string
#    Format: postgresql://USER:PASSWORD@HOST:PORT/DBNAME
DATABASE_URL=

# 3. Frontend points to backend (change in production)
BACKEND_URL=

# 4. App settings
DEBUG=False

# 5. JWT secret — generate with: python -c "import secrets; print(secrets.token_hex(16))"
SECRET_KEY=

COOKIE_SECRET_KEY=
